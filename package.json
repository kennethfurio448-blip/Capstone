{
  "name": "new-medtrack",
  "version": "1.0.1",
  "main": "desktop/main.cjs",
  "scripts": {
    "check": "node scripts/check-project.mjs",
    "test": "npm run check && npm run test:backup-format && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:backup-format": "node scripts/test-backup-format.mjs",
    "backup:create": "node scripts/create-automated-backup.mjs",
    "verify:backup": "node scripts/verify-backup.mjs",
    "test:backup-restore": "node scripts/test-backup-restore.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "desktop:start": "electron .",
    "desktop:build": "electron-builder --win nsis --x64 --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kennethfurio448-blip/Capstone.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kennethfurio448-blip/Capstone/issues"
  },
  "homepage": "https://github.com/kennethfurio448-blip/Capstone#readme",
  "description": "Secure medical inventory and emergency resource management system for PDRRMO.",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "supabase": "^2.117.0"
  },
  "build": {
    "appId": "ph.gov.quezon.pdrrmo.medtrack",
    "productName": "MedTrack",
    "copyright": "Copyright © PDRRMO Quezon",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "assets/pdrrmo-logo-transparent.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/pdrrmo-logo-transparent.png",
      "artifactName": "MedTrack-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MedTrack",
      "deleteAppDataOnUninstall": false
    }
  }
}
